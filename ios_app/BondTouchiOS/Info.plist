<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Bond Touch</string>
    <key>CFBundleDisplayName</key>
    <string>Bond Touch</string>
    <key>CFBundleIdentifier</key>
    <string>com.bondtouch.app</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Bluetooth Permissions -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Bond Touch needs Bluetooth to connect to your wearable bracelet and receive haptic touches 24/7.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Bond Touch needs Bluetooth to connect to your wearable bracelet.</string>

    <!-- Background Modes for 24/7 BLE -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- Network -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
